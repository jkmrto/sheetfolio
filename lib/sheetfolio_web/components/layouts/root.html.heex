<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>Sheetfolio</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <script defer src={app_js_path()}></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; background: #f8fafc; color: #1e293b; }
      header { background: #1e293b; color: white; padding: 1rem 2rem; display: flex; align-items: center; gap: 2rem; }
      header h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.5px; }
      header h1 a { color: inherit; text-decoration: none; }
      header h1 a:hover { color: #94a3b8; }
      nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
      nav a { color: #94a3b8; text-decoration: none; font-size: 0.95rem; padding: 0.25rem 0.5rem; border-radius: 6px; white-space: nowrap; }
      nav a:hover { color: white; }
      nav a.active { color: white; background: rgba(255,255,255,0.1); }
      .nav-gear { margin-left: auto; color: #94a3b8; text-decoration: none; font-size: 1.2rem; line-height: 1; padding: 0.3rem 0.5rem; border-radius: 6px; }
      .nav-gear:hover { color: white; }
      .nav-gear.active { color: white; background: rgba(255,255,255,0.1); }
      main { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
      .chart-container { background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
      .nav-toggle { display: none; }
      .burger, .nav-backdrop { display: none; }
      @media (max-width: 768px) {
        /* Every font size in the app is in rem, so dropping the root by a
           point takes the whole page down with it. */
        html { font-size: 14px; }
        header { padding: 0.9rem 1rem; gap: 1rem; }
        header h1 { font-size: 1.25rem; }
        .burger { display: block; order: -1; color: #94a3b8; font-size: 1.5rem; line-height: 1; cursor: pointer; padding: 0.2rem 0.4rem; border-radius: 6px; }
        nav { position: fixed; top: 0; left: 0; bottom: 0; z-index: 20; width: 15rem; padding: 1.25rem 1rem; background: #0f172a; flex-direction: column; flex-wrap: nowrap; gap: 0.25rem; overflow-y: auto; transform: translateX(-100%); transition: transform 0.2s ease; }
        nav a { font-size: 1rem; padding: 0.7rem 0.75rem; }
        .nav-toggle:checked ~ nav { transform: none; }
        .nav-toggle:checked ~ .nav-backdrop { display: block; position: fixed; inset: 0; z-index: 10; background: rgba(15,23,42,0.5); }
        main { margin: 1.25rem auto; }
        .chart-container { padding: 1rem; }
        /* A table can't scroll on its own, so a wide one drags the whole page
           sideways; display:block gives it a scroll box of its own. The tables
           set `overflow: hidden` themselves (to clip their rounded corners),
           and a class beats a plain `main table`, hence the [class] match. */
        main table, main table[class] { display: block; overflow-x: auto; }
        /* The label column (asset, category, month) stays put while the
           numbers scroll past it. A sticky cell has to be opaque, and :where()
           carries no specificity, so a page that gives its own header, footer
           or hovered row a background still wins over this fallback. */
        main table th:first-child, main table td:first-child { position: sticky; left: 0; z-index: 1; }
        :where(main table th:first-child, main table td:first-child) { background: white; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1><a href="/">Sheetfolio</a></h1>
      <%= if Map.get(assigns, :authenticated) do %>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="burger" aria-label="Menu">☰</label>
        <nav>
          <a href="/summary" class={if current_path(assigns) in ["/summary", "/summary/settled"], do: "active", else: ""}>Positions</a>
          <a href="/summary/dca" class={if String.starts_with?(current_path(assigns), "/summary/dca"), do: "active", else: ""}>DCA Impact</a>
          <a href="/history" class={if current_path(assigns) == "/history", do: "active", else: ""}>History</a>
          <a href="/comparison" class={if current_path(assigns) == "/comparison", do: "active", else: ""}>Compare</a>
          <a href="/cash" class={if current_path(assigns) in ["/cash", "/expenses"], do: "active", else: ""}>Money</a>
          <a href="/urbanitae" class={if current_path(assigns) == "/urbanitae", do: "active", else: ""}>Urbanitae</a>
          <a href="/equito" class={if current_path(assigns) == "/equito", do: "active", else: ""}>Equito</a>
          <a href="/bitcoin" class={if current_path(assigns) == "/bitcoin", do: "active", else: ""}>Bitcoin</a>
          <a href="/earnings" class={if current_path(assigns) == "/earnings", do: "active", else: ""}>Earnings</a>
          <a href="/operations" class={if current_path(assigns) == "/operations", do: "active", else: ""}>Operations</a>
        </nav>
        <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>
        <a href="/control" title="Control" aria-label="Control"
           class={"nav-gear#{if current_path(assigns) == "/control", do: " active", else: ""}"}>⚙</a>
      <% end %>
    </header>
    <main><%= @inner_content %></main>
  </body>
</html>
